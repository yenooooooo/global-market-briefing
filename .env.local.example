# ============================================
# 글로벌 마켓 브리핑 — 환경 변수 템플릿
# ============================================
# 이 파일을 복사하여 .env.local로 만들고 값을 채워주세요.
# cp .env.local.example .env.local

# ── Supabase 연결 정보 ──
# Supabase 대시보드 > Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Anthropic Claude API ──
# https://console.anthropic.com/ 에서 API 키 발급
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── 환율 API ──
# https://www.exchangerate-api.com/ 에서 무료 키 발급
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key-here
